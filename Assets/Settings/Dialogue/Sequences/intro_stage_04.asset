  sequenceId: intro_stage_04
  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uBC29\uC1A1\uAD6D \uB300\uAE30\uC2E4. \uBAA8\uB2C8\uD130\uC5D0\uC11C
      \uD30C\uC774\uB110 \uC608\uACE0\uAC00 \uD758\uB7EC\uB098\uC628\uB2E4.\n'LUX//FAUNA\uC640
      \uB9DE\uC124 \uB9C8\uC9C0\uB9C9 \uB3C4\uC804\uC790\uB294?'"
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uD654\uBA74\uC774 \uB300\uAE30\uC2E4\uC758 \uC138 \uC0AC\uB78C\uC73C\uB85C
      \uBC14\uB010\uB2E4. \uB108\uAD6C\uB9AC\uAC00 \uD669\uAE09\uD788 \uC790\uC138\uB97C
      \uACE0\uCE5C\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: nervous
    text: "\uC800\uAC70 \uC9C0\uAE08 \uB098\uAC00\uB294 \uAC70\uC57C?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB300\uAE30 \uD654\uBA74 \uC544\uB2C8\uC57C?"
    side: 1
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uBE68\uAC04 \uBD88 \uB4E4\uC5B4\uC654\uB294\uB370."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC544\uAE4C\uBD80\uD130 \uB098\uAC14\uB098?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB098 \uBC29\uAE08 \uC774 \uC464\uC168\uB294\uB370."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uB108 \uBC29\uC1A1 \uB9C1\uD06C \uBCF4\uB0C8\uC5B4?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC751. \uB2E8\uCCB4\uBC29\uC5D0."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC9C0\uAE08?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uBCF4\uB0B4\uB2EC\uB77C\uBA70."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "...\uADF8\uB7EC\uAE34 \uD588\uC9C0."
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uAC00 \uCF00\uC774\uBE14\uC744 \uB2E4\uC2DC \uD655\uC778\uD558\uACE0
      \uBCA0\uC774\uC2A4\uB97C \uC9E7\uAC8C \uD295\uAE34\uB2E4."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB0B4 \uC18C\uB9AC \uB4E4\uB824?"
    side: 1
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB124."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uAC00 \uAC19\uC740 \uC74C\uC744 \uD55C \uBC88 \uB354
      \uD295\uAE34\uB2E4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB4E4\uB824\uC694. \uBC29\uAE08\uB3C4 \uB4E4\uB838\uC5B4\uC694."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uD615\uC740 \uBC29\uC1A1 \uD574\uBD24\uC8E0?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB179\uD654\uB294."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC0DD\uBC29\uC740\uC694?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "...\uCC98\uC74C."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC624\uB298 \uD1B5\uACFC\uD558\uBA74 \uC9C4\uC9DC \uC800\uAE30 \uAC00\uB294
      \uAC70\uB124."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC77C\uB2E8 \uC624\uB298 \uAC83\uBD80\uD130 \uD558\uC790. \uB098 \uC190\uC5D0
      \uB540\uB098."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uACE0\uC2B4\uB3C4\uCE58\uAC00 \uC5EC\uBD84 \uC2A4\uD2F1\uC744 \uC606\uC5D0
      \uB193\uB294\uB2E4. \uC2A4\uD0DC\uD504\uAC00 \uC138 \uC0AC\uB78C\uC744 \uBD80\uB978\uB2E4."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uD734\uB300\uC804\uD654 \uB0B4\uB824\uB194. \uC6B0\uB9AC \uB4E4\uC5B4\uAC04\uB2E4."
    side: 1
    sfxId: 
