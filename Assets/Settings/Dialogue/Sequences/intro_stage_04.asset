  - speakerId: promoter
    speakerName: "\uACF5\uC5F0 \uAE30\uD68D\uC790"
    portrait: {fileID: 0}
    emotionId: serious
    text: "\uC624\uB298 \uACF5\uC5F0\uC740 \uC0DD\uBC29\uC1A1\uC774\uC57C. \uC798\uD558\uBA74
