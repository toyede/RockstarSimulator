  m_Script: {fileID: 11500000, guid: d6525ea3e323dc84dbc38cc118938d9b, type: 3}
  m_Name: intro_stage_02
  m_EditorClassIdentifier: Assembly-CSharp::ContextStage.DialogueSequence
  sequenceId: intro_stage_02
  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC9C0\uD558 \uB77C\uC774\uBE0C\uD640\uC758 \uC624\uD504\uB2DD \uBB34\uB300.\n\uAD6C\uC11D\uC5D0\uC11C\uB294
      \uC2A4\uCEF9\uD06C\uAC00 \uBCA0\uC774\uC2A4\uC640 \uC7A5\uBE44\uB97C \uC815\uB9AC\uD558\uACE0
      \uC788\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: nervous
    text: "\uAE30\uD0C0 \uC570\uD504\uC5D0\uC11C \uC18C\uB9AC\uAC00 \uC548 \uB098.
      \uC785\uB825 \uCF00\uC774\uBE14\uC774 \uD5D0\uAC70\uC6B4\uAC00?"
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC544\uAE4C\uB294 \uB0AC\uC796\uC544."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB108\uAD6C\uB9AC\uAC00 \uBCFC\uB968\uC744 \uCF20 \uCC44 \uC785\uB825
      \uCF00\uC774\uBE14\uC744 \uBF51\uB294\uB2E4.\n\uD391! \uC570\uD504\uC5D0\uC11C
      \uD070 \uC18C\uB9AC\uAC00 \uB098\uBA70 \uBA3C\uC9C0\uAC00 \uD284\uB2E4."
    side: 0
    sfxId: guitar_stroke
    presentationCue: cable_pop
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uBCFC\uB968 \uCF20 \uCC44\uB85C \uC785\uB825 \uCF00\uC774\uBE14\uC744
      \uBF51\uC740 \uAC70\uC57C?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: nervous
    text: "\uC18C\uB9AC\uAC00 \uC548 \uB098\uC11C\uC694."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uADF8\uB798\uC11C \uADF8\uB0E5 \uBF51\uC558\uC5B4?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "...\uB124."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC570\uD504 \uBCFC\uB968\uBD80\uD130 \uB0B4\uB824. \uCF00\uC774\uBE14\uC740
      \uB0B4\uAC00 \uAF42\uC744\uAC8C."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uACE0\uC7A5 \uB09C \uAC70\uC608\uC694?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC7A0\uAE50."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uAC00 \uC570\uD504\uB97C \uC0B4\uD540\uB2E4. \uB108\uAD6C\uB9AC\uB294
      \uACE0\uC2B4\uB3C4\uCE58 \uCABD\uC73C\uB85C \uBC14\uC9DD \uBD99\uB294\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC774\uAC70 \uBE44\uC2F8 \uBCF4\uC774\uB0D0?"
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB098\uD55C\uD14C \uBB3C\uC5B4\uBCF4\uC9C0 \uB9C8."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC785\uB825 \uC7AD \uB2E4\uC2DC \uAF42\uC558\uC5B4. \uAE30\uD0C0 \uC904
      \uD55C \uBC88 \uD295\uACA8\uBD10."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uAC00 \uC5F0\uACB0\uC744 \uD655\uC778\uD558\uACE0 \uC790\uAE30
      \uBCA0\uC774\uC2A4\uB97C \uD295\uAE34\uB2E4. \uB0AE\uC740 \uC74C\uC774 \uC815\uC0C1\uC801\uC73C\uB85C
      \uC6B8\uB9B0\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: relieved
    text: "...\uB2E4\uD589\uC774\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB0B4\uAC00 \uD560 \uB9D0\uC774\uACE0. \uB0B4 \uC570\uD504\uC57C."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC624\uB298 \uACF5\uC5F0\uD558\uB294 \uC560\uB4E4\uC774 \uB108\uD76C\uC57C?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB124."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uBA87 \uC2DC?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC2ED \uBD84 \uB4A4\uC694."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uBCA0\uC774\uC2A4\uB294 \uC5B4\uB514 \uC788\uB294\uB370?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC544\uC9C1 \uBABB \uAD6C\uD588\uC5B4\uC694."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uCCAB \uACE1 \uC778\uD2B8\uB85C \uC5EC\uB35F \uB9C8\uB514\uB9CC \uB9DE\uCDB0\uBCF4\uC790.
      \uBCA0\uC774\uC2A4\uB294 \uB0B4\uAC00 \uB123\uC744\uAC8C."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uD569\uC8FC\uAC00 \uC2DC\uC791\uB418\uC790 \uC2A4\uCEF9\uD06C\uAC00 \uBCA0\uC774\uC2A4\uB97C
      \uC5B9\uB294\uB2E4.\n\uB3CC\uC544\uBCF4\uB294 \uB108\uAD6C\uB9AC\uC5D0\uAC8C
      \uC55E\uC744 \uBCF4\uB77C\uB294 \uB208\uC9D3\uC774 \uB3CC\uC544\uC628\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uADF8\uB300\uB85C \uACF5\uC5F0\uAE4C\uC9C0 \uD574\uC8FC\uC2DC\uBA74 \uC548
      \uB3FC\uC694?"
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC9C0\uAE08?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC9C0\uAE08 \uC544\uB2C8\uBA74 \uB2E4\uC74C \uC0AC\uB78C\uC774 \uC5C6\uC5B4\uC694."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uB294 \uC2DC\uACC4\uB97C \uBCF4\uACE0\uB3C4 \uBCA0\uC774\uC2A4\uB97C
      \uB0B4\uB824\uB193\uC9C0 \uC54A\uB294\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uACE1 \uC21C\uC11C\uB791 \uD6C4\uB834 \uB4E4\uC5B4\uAC00\uB294 \uB9C8\uB514
      \uC801\uC5B4\uC918. \uC624\uB298 \uBCA0\uC774\uC2A4\uB294 \uB0B4\uAC00 \uB9E1\uC744\uAC8C."
    side: 1
    sfxId: 
    presentationCue: 
