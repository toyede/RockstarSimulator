  sequenceId: intro_stage_02
  lines:
  - speakerId: staff
    speakerName: "\uACF5\uC5F0\uC7A5 \uC9C1\uC6D0"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uACE8\uBAA9\uC5D0\uC11C \uC0AC\uB78C\uB4E4\uC744 \uBA48\uCDB0 \uC138\uC6E0\uB2E4\uB294
      \uBC34\uB4DC\uAC00 \uB108\uD76C\uC57C? \uC624\uB298 \uC624\uD504\uB2DD \uC790\uB9AC\uAC00
      \uD558\uB098 \uBE44\uC5C8\uC5B4."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: surprised
    text: "\uCC98, \uCC9C\uC7A5\uC774 \uC788\uC5B4\u2026 \uC870\uBA85\uB3C4\u2026
      \uC9C0, \uC9C4\uC9DC \uBB34\uB300\uB2E4\u2026!"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: grin
    text: "\uAE34\uC7A5 \uD480\uC5B4! \uC5EC\uAE34 \uB2E8\uACE8\uC774 \uB9CE\uC544\uC11C
      \uC6D0\uD558\uB294 \uAC78 \uB300\uB193\uACE0 \uB9D0\uD558\uB294 \uD32C\uB3C4
      \uC788\uC5B4. \uC624\uD788\uB824 \uD3B8\uD558\uC9C0!"
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: think
    text: "\uC6D0\uD558\uB294 \uAC78 \uB9D0\uD574\uC900\uB2E4\uBA74\u2026 \uADF8\uAC74
      \uB098\uB3C4 \uC54C\uC544\uB4E4\uC744 \uC218 \uC788\uC5B4. \uD2B9\uBCC4 \uAD00\uAC1D\uC774
      \uC694\uCCAD\uD558\uBA74 \uADF8 \uC131\uD5A5\uC758 Special \uCE74\uB4DC\uB97C
      \uC9C1\uC811 \uAC74\uB124\uC790."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: cheer
    text: "\uADF8\uAC70\uC57C! \uB300\uC2E0 \uC2DC\uAC04 \uC548\uC5D0 \uD574. \uB2E8\uACE8\uC740
      \uAE30\uB2E4\uB824\uC8FC\uC9C0 \uC54A\uAC70\uB4E0!"
    side: 0
    sfxId: 
