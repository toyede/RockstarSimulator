  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uD0C0\uB514\uC6C0 \uBC16. \uB300\uD615 \uC804\uAD11\uD310\uC5D0
      RACCOON ROLL\uC758 \uB2E4\uC74C \uD22C\uC5B4 \uAD11\uACE0\uAC00 \uB72C\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: happy
    text: "\uC7A0\uAE50. \uC6B0\uB9AC \uB098\uC628\uB2E4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC544\uAE4C\uB3C4 \uBD24\uC5B4."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC0AC\uC9C4 \uC880 \uCC0D\uC5B4\uC918. \uAD11\uACE0 \uBC14\uB00C\uAE30
      \uC804\uC5D0."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uADF8\uB7FC \uC774\uAC70 \uBC1B\uC544."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC7A5\uBE44\uB97C \uB118\uACA8\uBC1B\uB294 \uC0AC\uC774 \uC804\uAD11\uD310\uC774
      \uB2E4\uB978 \uAD11\uACE0\uB85C \uBC14\uB010\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC544."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB610 \uB098\uC624\uACA0\uC9C0."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uD615 \uBA3C\uC800 \uAC00\uC154\uB3C4 \uB3FC\uC694."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB098\uB3C4 \uCC0D\uC5B4\uC57C\uC9C0."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uAC00 \uC7A5\uBE44\uB97C \uB0B4\uB824\uB193\uB294\uB2E4.
      \uC7A0\uC2DC \uB4A4 \uC138 \uC0AC\uB78C\uC758 \uAD11\uACE0\uAC00 \uB2E4\uC2DC
      \uB3CC\uC544\uC628\uB2E4."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB108\uB3C4 \uB4E4\uC5B4\uC640. \uD0C0\uC774\uBA38 \uD574\uB193\uACE0."
    side: 1
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uD3F0 \uC5B4\uB514 \uC138\uC6CC?"
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uB0B4 \uCF00\uC774\uC2A4\uC5D0 \uAE30\uB300."
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC0AC\uC9C4\uC774 \uCC0D\uD788\uB294 \uC21C\uAC04, \uB108\uAD6C\uB9AC
      \uD63C\uC790 \uB4A4\uB3CC\uC544\uC11C \uC804\uAD11\uD310\uC744 \uBCF4\uACE0
      \uC788\uB2E4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "...\uD55C \uBC88 \uB354 \uCC0D\uC790."
    side: 1
    sfxId: 
