  m_Script: {fileID: 11500000, guid: d6525ea3e323dc84dbc38cc118938d9b, type: 3}
  m_Name: ending_mosh
  m_EditorClassIdentifier: Assembly-CSharp::ContextStage.DialogueSequence
  sequenceId: ending_mosh
  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uD22C\uC5B4\uAC00 \uB05D\uB09C \uB4A4, \uB2E4\uC2DC \uCC3E\uC740 \uC9C0\uD558
      \uD074\uB7FD.\n\uB9C8\uC9C0\uB9C9 \uACE1\uC774 \uB05D\uB098\uB3C4 \uBB34\uB300
      \uC55E\uC758 \uD32C\uB4E4\uC740 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: excited
    text: "\uBC1B\uC544\uC904 \uAC70\uC9C0?"
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uAD00\uAC1D\uB4E4\uC774 \uC190\uC744 \uB4E0\uB2E4. \uB108\uAD6C\uB9AC\uAC00
      \uBB34\uB300 \uBC16\uC73C\uB85C \uBAB8\uC744 \uAE30\uC6B8\uC778\uB2E4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC57C. \uAE30\uD0C0."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC544."
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uAE30\uD0C0\uB97C \uBC97\uC5B4\uB193\uC740 \uB108\uAD6C\uB9AC\uAC00 \uAD00\uAC1D\uB4E4\uC758
      \uC190 \uC704\uB85C \uB6F0\uC5B4\uB4E0\uB2E4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC624, \uB410\uB2E4."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uB3C4 \uC6C3\uC73C\uBA70 \uBB34\uB300 \uC55E\uC73C\uB85C
      \uB2E4\uAC00\uC628\uB2E4. \uB108\uAD6C\uB9AC\uB294 \uC810\uC810 \uAC1D\uC11D
      \uB4A4\uB85C \uBC00\uB824\uAC04\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC7A0\uAE50! \uB098 \uC5B4\uB514 \uAC00?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB4A4\uB85C \uAC04\uB2E4!"
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uBB34\uB300 \uCABD! \uBB34\uB300 \uCABD\uC73C\uB85C!"
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB108\uAD6C\uB9AC\uAC00 \uAD00\uAC1D\uB4E4 \uC704\uB97C \uB5A0\uAC04\uB2E4.
      \uBC97\uACA8\uC9C4 \uC655\uAD00\uC740 \uC5B4\uB290 \uD32C\uC758 \uC190\uC5D0
      \uB4E4\uB824 \uC788\uB2E4."
    side: 0
    sfxId: 
