  m_Script: {fileID: 11500000, guid: d6525ea3e323dc84dbc38cc118938d9b, type: 3}
  m_Name: intro_stage_05_boss
  m_EditorClassIdentifier: Assembly-CSharp::ContextStage.DialogueSequence
  sequenceId: intro_stage_05_boss
  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uD0C0\uB514\uC6C0 \uD30C\uC774\uB110. \uBB34\uB300 \uC785\uAD6C\uC5D0\uC11C
      \uC804\uC790\uC74C\uC545 \uB4C0\uC624 LUX//FAUNA\uC640 \uB9C8\uC8FC\uCE5C\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: neutral
    text: "\uBC29\uC1A1 \uBD24\uC5B4\uC694. \uD6C4\uB834 \uC88B\uB358\uB370."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC544, \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: neutral
    text: "\uD6C4\uB834 \uC55E \uBCA0\uC774\uC2A4 \uC194\uB85C \uC5EC\uB35F \uB9C8\uB514,
      \uB124 \uB9C8\uB514\uB85C \uC904\uC5EC\uBCF4\uC138\uC694."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: neutral
    text: "\uBC14\uB85C \uD6C4\uB834\uC73C\uB85C \uB4E4\uC5B4\uAC00\uBA74 \uBC18\uC751\uC774
      \uB354 \uBE60\uB97C \uAC70\uC608\uC694."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uBCA0\uC774\uC2A4\uB97C \uB9CC\uC9C0\uB358 \uC2A4\uCEF9\uD06C\uC758 \uC190\uC774
      \uC7A0\uAE50 \uBA48\uCD98\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC624\uB298\uC740 \uB9DE\uCDB0\uC628 \uB300\uB85C \uD558\uB824\uACE0\uC694."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: neutral
    text: "\uADF8\uB798\uC694? \uC800\uD76C\uB294 \uCCAB \uB4DC\uB78D \uC804\uC5D0
      \uAC1D\uC11D\uC774 \uC2DD\uC73C\uBA74 \uBE4C\uB4DC\uC5C5\uBD80\uD130 \uC798\uB77C\uC694."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uADF8 \uBCA0\uC774\uC2A4 \uC194\uB85C \uB4E3\uACE0 \uB9CC\uB4E0 \uD6C4\uB834\uC774\uB77C\uC11C\uC694.
      \uAC19\uC774 \uC5F0\uC8FC\uD558\uB824\uACE0\uC694."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: neutral
    text: "\uADF8\uB7FC \uACF5\uC5F0 \uB54C \uB4E4\uC5B4\uBCFC\uAC8C\uC694."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "LUX//FAUNA\uAC00 \uC2A4\uD0DC\uD504\uB97C \uB530\uB77C \uBB34\uB300\uB85C
      \uC62C\uB77C\uAC04\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uBB50\uB798?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uD6C4\uB834 \uC55E \uBCA0\uC774\uC2A4 \uC194\uB85C\uB97C \uC5EC\uB35F
      \uB9C8\uB514\uC5D0\uC11C \uB124 \uB9C8\uB514\uB85C \uC904\uC774\uB798."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: angry
    text: "\uC9C0\uAE08 \uC640\uC11C?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC548 \uC904\uC5EC. \uC544\uAE4C \uB9DE\uCD98 \uB300\uB85C \uAC00."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB9DE\uC740\uD3B8 \uBB34\uB300\uC5D0\uC11C \uCCAB \uC804\uC790\uC74C\uC774
      \uC6B8\uB9B0\uB2E4. \uAC1D\uC11D\uC774 \uD658\uD638\uB85C \uB4E4\uC369\uC778\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC800\uCABD\uC740 \uC18C\uB9AC\uB9CC \uB0B4\uB3C4 \uC88B\uC544\uD558\uB124."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB124 \uAE30\uD0C0\uB294 \uC18C\uB9AC \uB098\uC640?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB108\uAD6C\uB9AC\uAC00 \uC904\uC744 \uD295\uAE34\uB2E4. \uC544\uBB34
      \uC18C\uB9AC\uB3C4 \uB098\uC9C0 \uC54A\uB294\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "...\uC7A0\uAE50."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB108\uAD6C\uB9AC\uAC00 \uAE30\uD0C0 \uBCFC\uB968\uC744 \uC62C\uB9B0\uB2E4.
      \uC774\uBC88\uC5D0\uB294 \uC18C\uB9AC\uAC00 \uB09C\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC88B\uC544. \uC774\uC81C \uC6B0\uB9AC\uB3C4 \uC18C\uB9AC\uB294 \uB09C\uB2E4."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC800\uD76C \uCABD\uB3C4 \uC798 \uB4E4\uB9AC\uC138\uC694?"
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uBB34\uB300 \uC55E\uC5D0\uC11C \uBA87\uBA87 \uAD00\uAC1D\uC774 \uC190\uC744
      \uB4E4\uACE0 \uC18C\uB9AC\uCE5C\uB2E4."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uB410\uC8E0?"
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC751."
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uAC00?"
    side: 1
    sfxId: 
    presentationCue: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uAC00\uC790."
    side: 0
    sfxId: 
    presentationCue: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: excited
    text: "\uC6D0, \uD22C. \uC6D0, \uD22C, \uC4F0\uB9AC, \uD3EC!"
    side: 1
    sfxId: 
    presentationCue: 
