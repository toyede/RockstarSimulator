  m_Script: {fileID: 11500000, guid: d6525ea3e323dc84dbc38cc118938d9b, type: 3}
  m_Name: intro_stage_05_boss
  m_EditorClassIdentifier: Assembly-CSharp::ContextStage.DialogueSequence
  sequenceId: intro_stage_05_boss
  lines:
  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: cold
    text: "\uC785\uC7A5 \uD655\uC778. RACCOON ROLL. \uC608\uC0C1 \uC2B9\uB960 3.2%.
      \uC624\uB298 \uAD00\uAC1D\uC758 87%\uB294 \uC774\uBBF8 \uC800\uD76C \uCABD\uC5D0
      \uC11C \uC788\uC2B5\uB2C8\uB2E4."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: calm
    text: "\u2026\uC22B\uC790\uB85C \uB2E4 \uC544\uB294 \uAC83\uCC98\uB7FC \uB9D0\uD558\uB124."
    side: 0
    sfxId: 
  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: confident
    text: "\uC800\uD76C\uB294 \uAD00\uAC1D\uC758 \uB208\uCE58\uB97C \uBCF4\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uAD00\uAC1D\uC774 \uC800\uD76C\uB97C \uB530\uB77C\uC624\uB3C4\uB85D
      \uC124\uACC4\uD560 \uBFD0."
    side: 1
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: angry
    text: "\uC124\uACC4 \uC88B\uC544\uD558\uB124! \uAD00\uAC1D\uC740 \uACC4\uC0B0\uAE30\uAC00
      \uC544\uB2C8\uC57C. \uC57C, \uB108\uAD6C\uB9AC. \uACE8\uBAA9\uC5D0\uC11C \uBB50\uB77C\uACE0
      \uD588\uB354\uB77C?"
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: resolve
    text: "\u2026\uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uD588\uC5B4.
      \uB77C\uC774\uBC8C \uBB34\uB300\uC758 \uD32C\uC774 \uB9CE\uC744\uC218\uB85D
      \uC6B0\uB9AC \uC810\uC218\uAC00 \uAE4E\uC5EC. \uADF8\uB7EC\uB2C8\uAE4C \uBE8F\uC5B4\uC628\uB2E4.
      \uD55C \uBA85\uC529, \uC804\uBD80."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: cheer
    text: "\uADF8\uB798\uC57C \uC6B0\uB9AC \uBCF4\uCEEC\uC774\uC9C0! \uD328\uD134
      \uB728\uBA74 \uC815\uBA74\uC73C\uB85C \uBC1B\uC544\uCCD0. \uAD00\uAC1D \uACFC\uBC18\uC218\uB97C
      \uB118\uAE30\uBA74 \uC800 \uB85C\uBD07\uB4E4, \uD654\uB0BC \uAC70\uB2E4!"
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: shout
    text: "Raccoon Roll\u2026 \uC2DC\uC791\uD558\uC790!"
    side: 0
    sfxId: 
