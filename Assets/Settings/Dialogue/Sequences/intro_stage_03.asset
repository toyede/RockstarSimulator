  m_Script: {fileID: 11500000, guid: d6525ea3e323dc84dbc38cc118938d9b, type: 3}
  m_Name: intro_stage_03
  m_EditorClassIdentifier: Assembly-CSharp::ContextStage.DialogueSequence
  sequenceId: intro_stage_03
  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uD398\uC2A4\uD2F0\uBC8C \uB300\uAE30 \uAD6C\uC5ED. \uB108\uAD6C\uB9AC\uAC00
      \uD734\uB300\uC804\uD654\uC5D0\uC11C \uC624\uB798\uB41C \uACF5\uC5F0 \uC601\uC0C1\uC744
      \uCC3E\uC558\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uD615, \uC774 \uBC34\uB4DC\uC5D0\uB3C4 \uC788\uC5C8\uC5B4\uC694?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uADF8\uAC78 \uC5B4\uB514\uC11C \uCC3E\uC558\uC5B4?"
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uAC80\uC0C9\uD558\uB2C8\uAE4C \uB098\uC624\uB358\uB370\uC694. \uBC34\uB4DC\uAC00
      \uBA87 \uAC1C\uC608\uC694?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uADF8\uB9CC \uC880 \uB118\uACA8."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC774 \uACE1\uC740 \uC81C\uBAA9\uC774 \uBB50\uC608\uC694? \uC74C\uC6D0\uC774
      \uC548 \uB098\uC624\uB294\uB370."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC548 \uB0C8\uC5B4."
    side: 1
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC65C\uC694? \uAD1C\uCC2E\uC740\uB370."
    side: 1
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC804\uC5D0 \uC798\uB41C \uACE1\uC774 \uC788\uC5C8\uAC70\uB4E0. \uADF8\uB7F0
      \uAC78 \uBA3C\uC800 \uB0B4\uC790\uACE0 \uD574\uC11C."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uADF8\uB7FC \uC774\uAC74\uC694?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB098\uC911\uC5D0 \uD558\uC790\uB354\uB77C."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uACB0\uAD6D \uC548 \uD588\uC5B4\uC694?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC751. \uB2E4\uB978 \uACE1 \uAC00\uC838\uAC00\uB3C4 \uBE44\uC2B7\uD588\uACE0."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uADF8\uB798\uC11C \uB098\uC628 \uAC70\uC608\uC694?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "...\uB4E4\uC5B4\uB294 \uBCF4\uACE0 \uBC14\uAFB8\uB77C\uB4E0\uAC00."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB108\uAD6C\uB9AC\uAC00 \uC601\uC0C1\uC744 \uBA48\uCD98\uB2E4. \uC2A4\uCEF9\uD06C\uB294
      \uD734\uB300\uC804\uD654\uC5D0\uC11C \uC2DC\uC120\uC744 \uB5C0\uB2E4."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC6B0\uB9AC \uC21C\uC11C\uB098 \uBD10."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uBA54\uC778 \uBB34\uB300 \uC804\uAD11\uD310\uC5D0 'HEADLINER: LUX//FAUNA'\uAC00
      \uB72C\uB2E4.\n\uC548\uB0B4 \uBC29\uC1A1\uC744 \uB4E4\uC740 \uAD00\uAC1D\uB4E4\uC774
      \uC774\uB3D9\uD558\uAE30 \uC2DC\uC791\uD55C\uB2E4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC800\uCABD\uB3C4 \uC9C0\uAE08 \uC2DC\uC791\uD558\uB098 \uBD10\uC694."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC6B0\uB9AC\uB791 \uACB9\uCE58\uB124. \uB2E4 \uC800\uAE30\uB85C \uAC00\uB294\uB370?"
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uAC00 \uC791\uC740 \uBB34\uB300 \uC55E\uC5D0 \uB0A8\uC544
      \uC788\uB294 \uC0AC\uB78C\uB4E4\uC744 \uAC00\uB9AC\uD0A8\uB2E4."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC800\uAE30 \uAE30\uB2E4\uB9AC\uC796\uC544. \uB4E4\uC5B4\uAC00\uC790."
    side: 1
    sfxId: 
