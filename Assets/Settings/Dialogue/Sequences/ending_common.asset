  - speakerId: rival
    speakerName: LUX//FAUNA
    portrait: {fileID: 21300000, guid: 254fd7c2586c89e42a01d756ea2dffb3, type: 3}
    emotionId: defeat
    text: "\u2026\uC7AC\uACC4\uC0B0 \uC911. \uC608\uCE21 \uC624\uCC28 \uC6D0\uC778:
      \uBD88\uBA85. \uAD00\uAC1D\uC774 \uBC34\uB4DC\uB97C \uACE0\uB978 \uAC83\uC774
      \uC544\uB2C8\uB77C, \uBC34\uB4DC\uAC00 \uAD00\uAC1D\uC744\u2026 \uB4E4\uC5C8\uB2E4?"
    side: 1
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: smile
    text: "\uCC98\uC74C \uACE8\uBAA9\uC5D0\uC120 \uC138 \uBA85\uC774\uC5C8\uB294\uB370
