  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: resolve
    text: "\uC22B\uC790\uBCF4\uB2E4 \uC911\uC694\uD55C \uAC78 \uC54C\uC558\uC5B4.
      \uB2E4\uC74C \uBB34\uB300\uC5D0\uC11C\uB3C4, \uBA3C\uC800 \uAD00\uAC1D\uBD80\uD130
