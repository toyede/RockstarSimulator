  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC138 \uC0AC\uB78C\uC774 \uC9C1\uC811 \uB179\uC74C\uD558\uACE0 \uC62C\uB9B0
      \uC0C8 \uC2F1\uAE00.\n\uC791\uC740 \uC791\uC5C5\uC2E4\uC5D0\uC11C \uC74C\uC6D0\uACFC
      \uB77C\uC774\uBE0C \uC601\uC0C1\uC758 \uB313\uAE00\uC744 \uD655\uC778\uD55C\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: happy
    text: "\uC6B0\uB9AC \uACE1 \uCD94\uCC9C \uBAA9\uB85D\uC5D0 \uB4E4\uC5B4\uAC14\uC5B4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC5B4\uB514?"
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC5EC\uAE30. \uC0AC\uC9C4\uC740 \uC774\uAC78\uB85C \uB098\uAC00\uB124."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB0B4\uAC00 \uB208 \uAC10\uC740 \uAC70?"
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "...\uC791\uAC8C \uBCF4\uBA74 \uAD1C\uCC2E\uC544."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB09C \uD06C\uAC8C \uBCF4\uC774\uB294\uB370."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uD615, \uC774\uAC70 \uBB3C\uC5B4\uBCF4\uB294\uB370\uC694."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uBB58?"
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uBCA0\uC774\uC2A4 \uC5B4\uB5BB\uAC8C \uB179\uC74C\uD588\uB0D0\uACE0.
      1\uBD84 42\uCD08."
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC2A4\uCEF9\uD06C\uAC00 \uD574\uB2F9 \uAD6C\uAC04\uC744 \uB4E3\uB354\uB2C8
      \uAD6C\uC11D\uC758 \uC570\uD504\uB97C \uAC00\uB9AC\uD0A8\uB2E4."
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC800 \uC570\uD504."
    side: 1
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB124\uAC00 \uD130\uB728\uB9B4 \uBED4\uD55C \uAC70."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC548 \uD130\uC84C\uC796\uC544."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC0AC\uC9C4\uB3C4 \uC62C\uB824\uC904\uAE4C\uC694?"
    side: 0
    sfxId: 
  - speakerId: skunk
    speakerName: "\uC2A4\uCEF9\uD06C"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC751. \uB4A4\uCABD\uB3C4 \uCC0D\uC5B4\uC918."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB108\uAD6C\uB9AC\uAC00 \uC570\uD504 \uC0AC\uC9C4\uC744 \uCC0D\uB294\uB2E4.
      \uC2A4\uCEF9\uD06C\uB294 \uB179\uC74C \uBC29\uBC95\uC744 \uB313\uAE00\uB85C
      \uC801\uACE0 \uC788\uB2E4."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uD615, \uADF8\uAC78 \uB2E4 \uC4F0\uAC8C\uC694?"
    side: 1
    sfxId: 
