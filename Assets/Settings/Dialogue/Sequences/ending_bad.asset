  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uACF5\uC5F0\uC774 \uC911\uB2E8\uB418\uACE0 \uC7A5\uBE44\uB97C \uBE7C\uB2EC\uB77C\uB294
      \uB9D0\uC744 \uB4E4\uC5C8\uB2E4. \uBC16\uC5D0\uB294 \uCF00\uC774\uC2A4\uB4E4\uC774
      \uC313\uC5EC \uC788\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uB4DC\uB7FC\uB3C4 \uC9C0\uAE08 \uB2E4 \uBE7C\uB2EC\uB798."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC758\uC790 \uD558\uB098 \uB0A8\uC558\uC5B4. \uAC00\uC838\uC62C\uAC8C."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC624\uB298 \uC601\uC0C1 \uCC0D\uC5C8\uC5B4?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uCF1C\uB193\uAE34 \uD588\uB294\uB370."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uADF8\uAC74 \uC62C\uB9AC\uC9C0 \uB9C8."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC54C\uC558\uC5B4."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uB0B4\uAC00 \uB098\uC911\uC5D0 \uC62E\uAE38\uAC8C. \uB108 \uBA3C\uC800
      \uAC00."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uADF8\uAC78 \uD63C\uC790 \uC5B4\uB5BB\uAC8C \uB4E4\uC5B4."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC870\uAE08\uC529 \uC62E\uAE30\uBA74..."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB410\uC5B4. \uBC18\uB300\uCABD \uC7A1\uC544."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB458\uC774 \uB4DC\uB7FC \uCF00\uC774\uC2A4\uC758 \uC591\uCABD\uC744
      \uC7A1\uACE0 \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4."
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC5BC\uB8E9\uB9D0\uC774 \uCD9C\uC785\uBB38\uC744 \uC7A1\uC544\uC900\uB2E4."
    side: 0
    sfxId: 
  - speakerId: zebra
    speakerName: "\uC5BC\uB8E9\uB9D0"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uCC9C\uCC9C\uD788. \uBB38\uD131 \uC788\uC5B4."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "...\uD615 \uC570\uD504\uB3C4 \uC81C\uAC00 \uC62E\uAE38\uAC8C\uC694."
    side: 0
    sfxId: 
  - speakerId: zebra
    speakerName: "\uC5BC\uB8E9\uB9D0"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uB0B4 \uAC74 \uB0B4\uAC00 \uB4E4\uC5B4. \uB124 \uAE30\uD0C0\uBD80\uD130
      \uCC59\uACA8."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC5BC\uB8E9\uB9D0\uC740 \uB450 \uC0AC\uB78C\uC774 \uB098\uC62C \uB54C\uAE4C\uC9C0
      \uBB38\uC744 \uC7A1\uACE0 \uAE30\uB2E4\uB9B0\uB2E4."
    side: 0
