  sequenceId: intro_stage_01
  lines:
  - speakerId: staff
    speakerName: "\uACF5\uC5F0\uC7A5 \uC9C1\uC6D0"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC624\uB298 \uBB34\uB300\uB294 \uCDE8\uC18C\uC57C. \uC544\uC9C1 \uB108\uD76C\uB97C
      \uBCF4\uB7EC \uC62C \uAD00\uAC1D\uC774 \uC5C6\uAC70\uB4E0."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 0}
    emotionId: surprised
    text: "\uAD00\uAC1D\uC774 \uC5C6\uC5B4\uC11C \uBB34\uB300\uAC00 \uC5C6\uB2E4\uACE0?
      \uADF8\uB7FC \uBA3C\uC800 \uAD00\uAC1D\uC744 \uB9CC\uB4E4\uBA74 \uB418\uC796\uC544!"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 0}
    emotionId: sigh
    text: "\uB610 \uBB34\uC791\uC815 \uD06C\uAC8C \uC5F0\uC8FC\uD558\uB824\uB294
      \uAC74 \uC544\uB2C8\uC9C0? \uC9C0\uB098\uAC00\uB294 \uC0AC\uB78C\uC740 \uCDE8\uD5A5\uC774
      \uC804\uBD80 \uB2EC\uB77C."
    side: 0
    sfxId: 
  - speakerId: bandmate
    speakerName: "\uBC34\uB4DC \uB3D9\uB8CC"
    portrait: {fileID: 0}
    emotionId: explain
    text: "\uBCF5\uC7A5\uACFC \uC6C0\uC9C1\uC784\uC744 \uBD10. \uB204\uAD6C\uB294
      \uAC15\uB82C\uD55C \uC194\uB85C\uB97C, \uB204\uAD6C\uB294 \uB5BC\uCC3D\uC744,
      \uB204\uAD6C\uB294 \uD3B8\uD55C \uD750\uB984\uC744 \uC6D0\uD574."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 0}
    emotionId: resolve
    text: "\uC88B\uC544. \uC624\uB298\uC740 \uADC0\uBD80\uD130 \uC5F4\uACE0 \uC5F0\uC8FC\uD55C\uB2E4!"
    side: 0
