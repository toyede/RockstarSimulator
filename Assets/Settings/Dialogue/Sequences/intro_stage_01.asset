  sequenceId: intro_stage_01
  lines:
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: excited
    text: "\uC57C, \uB108\uAD6C\uB9AC! \uC624\uB298\uC774 \uADF8\uB0A0\uC774\uB77C\uACE0!
      \uACE8\uBAA9\uC774\uB4E0 \uC5B4\uB514\uB4E0 \uBB34\uB300\uB294 \uBB34\uB300\uC57C!"
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: nervous
    text: "\uC5B4, \uC5B4\u2026 \uC0AC\uB78C\uC774 \uC774\uB807\uAC8C \uB9CE\uC774
      \uC9C0\uB098\uAC00\uB294\uB370\u2026 \uC6B0\uB9AC \uB178\uB798\uB97C\u2026
      \uB4E4\uC5B4\uC904\uAE4C\u2026?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: grin
    text: "\uC548 \uB4E4\uC73C\uBA74 \uB4E3\uAC8C \uB9CC\uB4E4\uBA74 \uB418\uC9C0!
      \uADFC\uB370 \uBB34\uC791\uC815 \uD06C\uAC8C \uCE58\uC9C4 \uB9C8. \uC9C0\uB098\uAC00\uB294
      \uC0AC\uB78C\uC740 \uCDE8\uD5A5\uC774 \uC804\uBD80 \uB2EC\uB77C."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: think
    text: "\uCDE8\uD5A5\u2026 \uC637\uCC28\uB9BC\uC774\uB791 \uD45C\uC815\uC744 \uBCF4\uBA74\u2026
      \uC54C \uC218 \uC788\uC744\uC9C0\uB3C4. \uAC15\uB82C\uD55C \uAC78 \uC6D0\uD558\uB294
      \uC0AC\uB78C, \uAC19\uC774 \uBD80\uB974\uACE0 \uC2F6\uC740 \uC0AC\uB78C, \uD3B8\uD558\uAC8C
      \uB4E3\uACE0 \uC2F6\uC740 \uC0AC\uB78C\u2026"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: cheer
    text: "\uC624\uC624, \uC774\uC81C \uC880 \uBC34\uB4DC \uAC19\uB124! \uC790, \uADC0\uBD80\uD130
      \uC5F4\uACE0 \uAC04\uB2E4!"
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: resolve
    text: "\u2026\uC751. \uC624\uB298\uC740, \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uC744\uAC8C."
    side: 0
    sfxId: 
