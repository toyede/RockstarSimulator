  lines:
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC57C\uC678 \uACF5\uC5F0\uC774 \uB05D\uB09C \uB4A4. \uBC16\uC5D0\uC11C\uB294
      \uC544\uC9C1\uB3C4 \uD32C\uB4E4\uC774 \uD6C4\uB834\uC744 \uBD80\uB974\uACE0
      \uC788\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC624\uB298 \uC601\uC0C1 \uC774\uAC78\uB85C \uC62C\uB9B4\uAE4C?"
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC880 \uC55E\uC73C\uB85C \uB3CC\uB824\uBD10."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uD734\uB300\uC804\uD654\uC5D0\uC11C \uAD00\uAC1D\uB4E4\uC758 \uB178\uB7AB\uC18C\uB9AC\uAC00
      \uD130\uC838 \uB098\uC628\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uB0B4 \uBAA9\uC18C\uB9AC\uAC00 \uAC70\uC758 \uC548 \uB4E4\uB9AC\uB124."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB4A4\uCABD \uBD10. \uC800\uAE30\uAE4C\uC9C0 \uB2E4 \uBD80\uB978\uB2E4."
    side: 1
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uC5BC\uB8E9\uB9D0\uB3C4 \uB450 \uC0AC\uB78C \uC606\uC73C\uB85C \uC640\uC11C
      \uD654\uBA74\uC744 \uB4E4\uC5EC\uB2E4\uBCF8\uB2E4."
    side: 0
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uB2E4\uB978 \uAC01\uB3C4\uB3C4 \uCC3E\uC544\uBCFC\uAE4C\uC694?"
    side: 0
    sfxId: 
  - speakerId: zebra
    speakerName: "\uC5BC\uB8E9\uB9D0"
    portrait: {fileID: 0}
    emotionId: neutral
    text: "\uC65C? \uC774\uAC70 \uC88B\uC740\uB370."
    side: 1
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uC5EC\uAE30. \uB9C8\uC774\uD06C \uB0B4\uB9AC\uB294 \uB370\uBD80\uD130
      \uC62C\uB824."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "\uC544\uC9C1\uB3C4 \uBD80\uB974\uB124."
    side: 0
    sfxId: 
  - speakerId: hedgehog
    speakerName: "\uACE0\uC2B4\uB3C4\uCE58"
    portrait: {fileID: 21300000, guid: 38bd92e884c24db40a7bbb8974c72fd7, type: 3}
    emotionId: neutral
    text: "\uB108 \uC544\uAE4C \uB450 \uBC88 \uB354 \uC2DC\uCF30\uC796\uC544."
    side: 1
    sfxId: 
  - speakerId: raccoon
    speakerName: "\uB108\uAD6C\uB9AC"
    portrait: {fileID: 21300000, guid: 6afce5a0fffea944998d6e66899dcbbf, type: 3}
    emotionId: neutral
    text: "...\uADF8\uB7AC\uC9C0."
    side: 0
    sfxId: 
  - speakerId: 
    speakerName: 
    portrait: {fileID: 0}
    emotionId: 
    text: "\uB108\uAD6C\uB9AC\uAC00 \uC601\uC0C1\uC744 \uC62C\uB9B0\uB2E4. \uC5F4\uB9B0
      \uBB38 \uC0AC\uC774\uB85C \uD6C4\uB834\uC774 \uD55C \uBC88 \uB354 \uB4E4\uB824\uC628\uB2E4."
    side: 0
    sfxId: 
