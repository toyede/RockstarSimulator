  stageHeadlines:
  - stageId: stage_01
    s: "\uD1F4\uADFC\uAE38 \uB300\uC815\uCCB4\u2026 \uBC94\uC778\uC740 \uB108\uAD6C\uB9AC
      \uBC34\uB4DC"
    a: "\uC9D1\uC5D0 \uAC00\uB358 \uBC1C\uAC78\uC74C, \uC559\uCF54\uB974 \uC55E\uC5D0\uC11C
      \uBA48\uCDC4\uB2E4"
    b: "\uD1F4\uADFC\uAE38\uC5D0 \uBC1C\uACAC\uD55C \uC791\uC740 \uB77C\uC774\uBE0C"
    c: "\uC655\uAD00 \uC4F4 \uB108\uAD6C\uB9AC, \uACE8\uBAA9 \uB370\uBDD4 \uC131\uACF5"
    d: "\uC791\uC740 \uAD00\uAC1D\uC11D \uC9C0\uD0A4\uBA70 \uCCAB \uACF5\uC5F0 \uB9C8\uCCD0"
    fail: "\uAE30\uD0C0\uB294 \uCF30\uB294\uB370\u2026 \uBC1C\uAC78\uC74C\uC740 \uBABB
      \uC7A1\uC558\uB2E4"
  - stageId: stage_02
    s: "\uC9C0\uD558\uC2E4\uC5D0\uC11C \uC9C0\uC9C4? \uC544\uB2C8, \uBAA8\uC26C\uD54F\uC774\uC5C8\uB2E4"
    a: "\uCC9C\uC7A5 \uB0AE\uC740 \uACF5\uC5F0\uC7A5, \uD658\uD638\uB294 \uB192\uC558\uB2E4"
    b: "\uB0A1\uC740 \uC570\uD504 \uB108\uBA38\uB85C \uD130\uC9C4 \uD568\uC131"
    c: "\uC9C0\uD558 \uB77C\uC774\uBE0C\uD640 \uCCAB \uBB34\uB300, \uC77C\uB2E8 \uD569\uACA9"
    d: "\uC570\uD504\uB294 \uBC84\uD17C\uB2E4\u2026 \uBC34\uB4DC\uB3C4 \uBC84\uD17C\uB2E4"
    fail: "\uC570\uD504\uBCF4\uB2E4 \uBA3C\uC800 \uC2DD\uC5B4\uBC84\uB9B0 \uAC1D\uC11D"
  - stageId: stage_03
    s: "\uD398\uC2A4\uD2F0\uBC8C \uC9C0\uB3C4\uC5D0 \uC0C8 \uBA85\uC18C\uAC00 \uC0DD\uACBC\uB2E4"
    a: "\uC791\uC740 \uBB34\uB300\uC5D0\uC11C \uC2DC\uC791\uB41C \uAC70\uB300\uD55C
      \uB5BC\uCC3D"
    b: "\uD5E4\uB4DC\uB77C\uC774\uB108 \uC606\uC5D0\uC11C\uB3C4 \uC874\uC7AC\uAC10
      \uC99D\uBA85"
    c: "\uB0AF\uC120 \uD32C \uC55E\uC5D0\uC11C \uC774\uB984 \uC54C\uB9B0 \uB108\uAD6C\uB9AC"
    d: "\uD398\uC2A4\uD2F0\uBC8C \uBB34\uB300, \uC544\uC2AC\uC544\uC2AC\uD558\uAC8C
      \uC644\uC8FC"
    fail: "\uB113\uC740 \uBB34\uB300, \uBD99\uC7A1\uC9C0 \uBABB\uD55C \uBC1C\uAE38"
  - stageId: stage_04
    s: "\uC0DD\uBC29\uC1A1 \uCC22\uC5C8\uB2E4\u2026 \uC7AC\uBC29\uC1A1 \uC694\uCCAD
      \uC1C4\uB3C4"
    a: "\uCE74\uBA54\uB77C \uC55E\uC5D0\uC11C\uB3C4 \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uC740
      \uD569\uC8FC"
    b: "ON AIR! \uC548\uBC29\uAE4C\uC9C0 \uC804\uD55C \uB77C\uC774\uBE0C"
    c: "\uC0DD\uBC29\uC1A1 \uB370\uBDD4, \uAE34\uC7A5 \uC18D\uC5D0 \uBB34\uC0AC \uC644\uB8CC"
    d: "\uBC29\uC1A1 \uC0AC\uACE0 \uC5C6\uC774 \uCCAB \uCD9C\uC5F0 \uB9C8\uCCD0"
    fail: "\uBE68\uAC04 \uBD88\uC740 \uCF1C\uC84C\uC9C0\uB9CC \uD638\uC751\uC740
      \uAEBC\uC84C\uB2E4"
