  headlineS: "\uC624\uB298 \uBC24\uC758 \uC8FC\uC778\uACF5, \uB108\uAD6C\uB9AC \uBC34\uB4DC!"
  headlineA: "\uC3DF\uC544\uC9C0\uB294 \uD658\uD638\u2026 \uC81C\uB300\uB85C \uC774\uB984
    \uC54C\uB838\uB2E4!"
  headlineB: "\uAD00\uAC1D \uC0AC\uB85C\uC7A1\uC740 \uBB34\uB300, \uB2E4\uC74C \uACF5\uC5F0\uB3C4
    \uAE30\uB300"
  headlineC: "\uAC00\uB2A5\uC131 \uBCF4\uC5EC\uC900 \uB108\uAD6C\uB9AC \uBC34\uB4DC\uC758
    \uD55C \uBB34\uB300"
  headlineD: "\uCCAB \uAD00\uBB38 \uB118\uC5C8\uB2E4! \uB2E4\uC74C \uBB34\uB300 \uD5A5\uD558\uB294
    \uBC34\uB4DC"
  headlineFail: "\uC655\uAD00\uC740 \uD654\uB824\uD588\uC9C0\uB9CC, \uC624\uB298
    \uACF5\uC5F0\uC740 \uC090\uAC71"
  headlineBossWin: "LUX//FAUNA\uC640\uC758 \uC2B9\uBD80, \uC559\uCF54\uB974\uB294
    \uB108\uAD6C\uB9AC\uC5D0\uAC8C"
  headlineBossLose: "\uC624\uB298\uC758 \uC559\uCF54\uB974\uB294 LUX//FAUNA\u2026
    \uB2E4\uC74C \uC2B9\uBD80\uB97C \uAE30\uC57D"
  comboSubtitleMin: 10
  comboSubtitle: "\uCD5C\uACE0 {0}\uCF64\uBCF4, \uB04A\uC774\uC9C0 \uC54A\uB294 \uD638\uC751\uC73C\uB85C
    \uACF5\uC5F0 \uC774\uB04C\uC5B4"
  feverSubtitleMin: 2
  feverSubtitle: "\uD53C\uBC84 {0}\uD68C \uBC1C\uB3D9\u2026 \uBB34\uB300\uB97C \uB2EC\uAD70
    \uC5F0\uC18D \uACF5\uC5F0"
  specialSubtitleMin: 2
  specialSubtitle: "\uD2B9\uBCC4 \uAD00\uAC1D \uC694\uCCAD {0}\uD68C \uC131\uACF5,
    \uAE4C\uB2E4\uB85C\uC6B4 \uD32C\uB3C4 \uB9CC\uC871"
  crisisSubtitleMin: 1
  crisisSubtitle: "\uC774\uD0C8 \uC704\uAE30\uC5D0\uC11C \uAD00\uAC1D {0}\uBA85 \uBD99\uC7A1\uC544"
  defaultSubtitle: "\uBAA9\uD45C \uB2EC\uC131\uB960 {0}%\uB85C \uACF5\uC5F0\uC744
    \uB9C8\uCCE4\uB2E4"
  failSubtitle: "\uBAA9\uD45C\uAE4C\uC9C0 {0}\uC810 \uBD80\uC871\u2026 \uBC34\uB4DC\uB294
    \uB2E4\uC74C \uBB34\uB300\uB97C \uAE30\uC57D\uD588\uB2E4"
  bossWinSubtitle: "\uC0C1\uB300 \uD32C {0}\uBA85\uC774 \uB108\uAD6C\uB9AC \uBC34\uB4DC
    \uCABD\uC73C\uB85C \uC790\uB9AC\uB97C \uC62E\uACBC\uB2E4"
  bossWinSubtitleNoRecruit: "\uD328\uD134 {0}\uD68C \uC131\uACF5\uC73C\uB85C \uB77C\uC774\uBC8C
    \uBB34\uB300\uB97C \uC7A0\uC7AC\uC6E0\uB2E4"
  bossLoseSubtitle: "\uD328\uD134 {0}\uD68C \uC131\uACF5\uC5D0 \uADF8\uCCD0\u2026
    \uB2E4\uC74C \uB300\uACB0\uC744 \uAE30\uC57D\uD588\uB2E4"
  captionHigh: "\uD658\uD638 \uC18D\uC5D0 \uACF5\uC5F0\uC744 \uB9C8\uCE5C \uB108\uAD6C\uB9AC
    \uBC34\uB4DC. \uC624\uB298 \uBC24\uC740 \uC774\uB4E4\uC758 \uAC83\uC774\uC5C8\uB2E4."
  captionNormal: "\uACF5\uC5F0\uC744 \uB9C8\uCE5C \uB108\uAD6C\uB9AC \uBC34\uB4DC.
    \uC655\uAD00\uB9CC\uD07C\uC740 \uB05D\uAE4C\uC9C0 \uC9C0\uCF30\uB2E4."
  captionFail: "\uC090\uB6A4\uC5B4\uC9C4 \uC655\uAD00\uC744 \uACE0\uCCD0 \uC4F0\uB294
    \uB108\uAD6C\uB9AC. \uB3D9\uB8CC\uB4E4\uC740 \uC870\uC6A9\uD788 \uC7A5\uBE44\uB97C
    \uC815\uB9AC\uD588\uB2E4."
  captionBossWin: "\uB77C\uC774\uBC8C\uC744 \uB4A4\uB85C\uD558\uACE0 \uC559\uCF54\uB974
    \uBB34\uB300\uC5D0 \uC120 \uB108\uAD6C\uB9AC \uBC34\uB4DC."
  captionBossLose: "\uC870\uBA85\uC740 \uB77C\uC774\uBC8C \uBB34\uB300\uB85C \uD5A5\uD588\uB2E4.
    \uB108\uAD6C\uB9AC \uBC34\uB4DC\uB294 \uB2E4\uC74C\uC744 \uC900\uBE44\uD55C\uB2E4."
