  headlineS: "\uC624\uB298 \uBC24\uC758 \uC8FC\uC778\uACF5, \uB108\uAD6C\uB9AC \uBC34\uB4DC!"
  headlineA: "\uC3DF\uC544\uC9C0\uB294 \uD658\uD638\u2026 \uC81C\uB300\uB85C \uC774\uB984
    \uC54C\uB838\uB2E4!"
  headlineB: "\uAD00\uAC1D \uC0AC\uB85C\uC7A1\uC740 \uBB34\uB300, \uB2E4\uC74C \uACF5\uC5F0\uB3C4
    \uAE30\uB300"
  headlineC: "\uAC00\uB2A5\uC131 \uBCF4\uC5EC\uC900 \uB108\uAD6C\uB9AC \uBC34\uB4DC\uC758
    \uD55C \uBB34\uB300"
  headlineD: "\uCCAB \uAD00\uBB38 \uB118\uC5C8\uB2E4! \uB2E4\uC74C \uBB34\uB300 \uD5A5\uD558\uB294
    \uBC34\uB4DC"
  headlineFail: "\uC655\uAD00\uC740 \uD654\uB824\uD588\uC9C0\uB9CC, \uC624\uB298
    \uACF5\uC5F0\uC740 \uC090\uAC71"
  headlineBossWin: "\uB77C\uC774\uBC8C\uACFC\uC758 \uC815\uBA74 \uC2B9\uBD80, \uB108\uAD6C\uB9AC
    \uBC34\uB4DC \uC6C3\uC5C8\uB2E4"
  headlineBossLose: "\uB77C\uC774\uBC8C \uBB34\uB300\uC5D0 \uC870\uBA85\uC774\u2026
    \uB108\uAD6C\uB9AC \uBC34\uB4DC\uB294 \uC7AC\uC815\uBE44"
  comboSubtitleMin: 10
  comboSubtitle: "\uCD5C\uACE0 {0}\uCF64\uBCF4, \uB04A\uC774\uC9C0 \uC54A\uB294 \uD638\uC751\uC73C\uB85C
    \uACF5\uC5F0 \uC774\uB04C\uC5B4"
  feverSubtitleMin: 2
  feverSubtitle: "\uD53C\uBC84 {0}\uD68C \uBC1C\uB3D9\u2026 \uBB34\uB300\uB97C \uB2EC\uAD70
    \uC5F0\uC18D \uACF5\uC5F0"
  specialSubtitleMin: 2
  specialSubtitle: "\uD2B9\uBCC4 \uAD00\uAC1D \uC694\uCCAD {0}\uD68C \uC131\uACF5,
    \uAE4C\uB2E4\uB85C\uC6B4 \uD32C\uB3C4 \uB9CC\uC871"
  crisisSubtitleMin: 1
  crisisSubtitle: "\uC774\uD0C8 \uC704\uAE30\uC5D0\uC11C \uAD00\uAC1D {0}\uBA85 \uBD99\uC7A1\uC544"
  defaultSubtitle: "\uBAA9\uD45C \uB2EC\uC131\uB960 {0}%\uB85C \uACF5\uC5F0\uC744
    \uB9C8\uCCE4\uB2E4"
